---
import { interests } from '../data/site';
---

<div class="orbit-module" data-orbit-module>
  <div class="orbit-top mono">
    <span>
      <span class="status-dot"></span> CONNECTED INTERESTS
    </span>
    <span>JF / 01—04</span>
  </div>
  <div class="orbit-stage">
    <canvas class="orbit-canvas" aria-hidden="true"></canvas>
    <div class="orbit-fallback" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <span class="orbit-coordinate mono" aria-hidden="true">
      EXPLORE THE CONNECTIONS
    </span>
    <span class="orbit-center" aria-hidden="true">
      jf<span>CURIOUS BY DEFAULT</span>
    </span>
    <span class="orbit-label label-software" aria-hidden="true">
      &lt;/&gt;
    </span>
    <span class="orbit-label label-ai" aria-hidden="true">
      ✳
    </span>
    <span class="orbit-label label-game" aria-hidden="true">
      ＋
    </span>
    <span class="orbit-label label-it" aria-hidden="true">
      ⌘
    </span>
  </div>
  <div class="interest-controls" role="group" aria-label="Explore my interests">
    {interests.map((item, i) => (
      <button data-interest={i} aria-pressed={i === 0} aria-controls="interest-description">
        <span>{item.number}</span>
        {item.short}
      </button>
    ))}
  </div>
  <p id="interest-description" class="orbit-description" aria-live="polite">
    {interests[0].description}
  </p>
</div>
<script>
  import '../scripts/orbit';
</script>
