---
import Arrow from './Arrow.astro';
import ProjectArt from './ProjectArt.astro';
import { url } from '../data/site';
const { project, index = 0 } = Astro.props;
---

<article class="project-card" data-category={project.category}>
  <a
    class="project-visual-link"
    href={url(`projects/${project.slug}/`)}
    aria-label={`Explore ${project.title}`}
  >
    <ProjectArt type={project.art} />
    <span class="project-open">
      <Arrow diagonal />
    </span>
  </a>
  <div class="project-card-meta mono">
    <span>
      0{index + 1} / {project.category}
    </span>
    <span>{project.status}</span>
  </div>
  <h3>
    <a href={url(`projects/${project.slug}/`)}>
      {project.title}
      <Arrow diagonal />
    </a>
  </h3>
  <p>{project.description}</p>
  <ul class="tags" aria-label="Technologies">
    {project.tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
</article>
