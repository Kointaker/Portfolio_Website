---
const { type, large = false } = Astro.props;
---

<div class:list={['project-art', `art-${type}`, { large }]} aria-hidden="true">
  {type === 'centurion' && (
    <>
      <div class="art-orbit ring-one"></div>
      <div class="art-orbit ring-two"></div>
      <div class="menu-bar">
        <span>◈ &nbsp; Centurion</span>
        <span>◔ &nbsp; ⌕ &nbsp; 10:24</span>
      </div>
      <div class="centurion-window">
        <div class="window-header">
          <span class="shield">◇</span>
          <span>
            Centurion<small>Your codes, within reach.</small>
          </span>
          <span class="window-dot"></span>
        </div>
        <div class="code-label">LATEST VERIFICATION CODE</div>
        <div class="mock-code">
          482 691<span>⧉</span>
        </div>
        <div class="mock-meta">
          <span>Example service</span>
          <span>just now</span>
        </div>
        <div class="window-bottom">
          <span class="status-dot"></span> Processed on your Mac<span>⌘ C</span>
        </div>
      </div>
      <span class="art-caption">INTERFACE CONCEPT · SAMPLE DATA</span>
    </>
  )}
  {type === 'fly' && (
    <>
      <div class="fly-world">
        <div class="world-grid"></div>
        <div class="game-table">
          <div class="board-lines"></div>
          <div class="tile tile-1">✳</div>
          <div class="tile tile-2">✳</div>
          <div class="tile tile-3">✳</div>
          <div class="tile tile-4">✳</div>
          <span class="fly-piece piece-1"></span>
          <span class="fly-piece piece-2"></span>
          <span class="fly-piece piece-3"></span>
        </div>
        <span class="world-orbit"></span>
      </div>
      <div class="simulation-tag mono">
        <span class="status-dot"></span> A LITTLE WORLD IN MOTION
      </div>
      <span class="art-caption">ORIGINAL PORTFOLIO ILLUSTRATION</span>
    </>
  )}
  {type === 'neural' && (
    <>
      <svg class="neural-diagram" viewBox="0 0 500 280">
        <g stroke="currentColor" opacity=".3">
          {[
            [100, 95, 250, 65],
            [100, 95, 250, 205],
            [100, 185, 250, 65],
            [100, 185, 250, 205],
            [250, 65, 400, 140],
            [250, 205, 400, 140],
          ].map((c) => (
            <line x1={c[0]} y1={c[1]} x2={c[2]} y2={c[3]} />
          ))}
        </g>
        <g fill="#122b2d" stroke="currentColor">
          {[
            [100, 95],
            [100, 185],
            [250, 65],
            [250, 205],
            [400, 140],
          ].map((c) => (
            <>
              <circle cx={c[0]} cy={c[1]} r="24" />
              <circle cx={c[0]} cy={c[1]} r="5" fill="currentColor" />
            </>
          ))}
        </g>
        <g fill="currentColor" font-size="11" text-anchor="middle" font-family="monospace">
          <text x="100" y="255">
            INPUT
          </text>
          <text x="250" y="255">
            HIDDEN
          </text>
          <text x="400" y="255">
            OUTPUT
          </text>
        </g>
      </svg>
      <span class="formula mono">σ(x) = 1 / (1 + e⁻ˣ)</span>
      <span class="art-caption">FORWARD PASS · CONCEPTUAL DIAGRAM</span>
    </>
  )}
  {type === 'stats' && (
    <>
      <div class="chart-title mono">
        SIZE × PRICE<span>EXPLORING THE RELATIONSHIP</span>
      </div>
      <svg class="stats-diagram" viewBox="0 0 500 260">
        <g stroke="currentColor" opacity=".1">
          {[50, 100, 150, 200].map((y) => (
            <path d={`M45 ${y}H460`} />
          ))}
        </g>
        <path d="M45 25V220H465" fill="none" stroke="currentColor" opacity=".4" />
        <path
          d="M60 208 450 52"
          fill="none"
          stroke="currentColor"
          stroke-dasharray="5 6"
          opacity=".6"
        />
        {Array.from({ length: 27 }, (_, i) => (
          <circle
            cx={65 + i * 14}
            cy={200 - i * 5.5 + Math.sin(i * 2.1) * 39}
            r={i % 3 === 0 ? 5 : 4}
            fill={i % 3 === 0 ? '#b7a5ee' : i % 3 === 1 ? '#89dbbf' : '#76a6e4'}
            opacity=".85"
          />
        ))}
        <text x="250" y="250" fill="currentColor" font-family="monospace" font-size="10">
          SCREEN SIZE →
        </text>
      </svg>
      <span class="art-caption">ILLUSTRATIVE CHART · NOT DATA OUTPUT</span>
    </>
  )}
</div>
