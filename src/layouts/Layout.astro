---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { url, linkedin, github } from '../data/site';
const {
  title = 'Joshua Ferreira — Curious by default. Builder by practice.',
  description = 'The personal portfolio of Joshua Ferreira. Explore software, AI and machine learning, game development, and hands-on IT experience.',
  active = 'Home',
} = Astro.props;
const navigation = [
  { name: 'Home', path: '' },
  { name: 'My story', path: 'about/' },
  { name: 'Experience', path: 'experience/' },
  { name: 'Projects', path: 'projects/' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1117" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('social.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Joshua Ferreira — Curiosity, made tangible. Software, AI and ML, game development, IT."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title}</title>
    <noscript>
      <style is:inline>
        .motion-toggle,
        .interest-controls,
        .project-filters {
          display: none !important;
        }
        @media (max-width: 600px) {
          .site-header {
            height: auto !important;
            position: relative !important;
          }
          .nav-wrap {
            flex-wrap: wrap;
            padding-top: 18px;
          }
          .menu-toggle {
            display: none !important;
          }
          #navigation {
            display: flex !important;
            position: static !important;
            flex-direction: row;
            flex-wrap: wrap;
            width: 100%;
            box-shadow: none;
            border: 0;
            padding: 10px 0;
            gap: 8px;
          }
          #navigation > a {
            font-size: 11px;
            padding: 10px;
          }
          #navigation > a[aria-current]::after {
            display: none !important;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="nav-wrap container">
        <a class="brand" href={url()} aria-label="Joshua Ferreira home">
          <span class="brand-mark">
            j<span>f</span>
            <i></i>
          </span>
          <span class="brand-name">
            Joshua Ferreira<span>Developer & curious mind</span>
          </span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">
          Menu <span aria-hidden="true">＋</span>
        </button>
        <nav id="navigation" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={url(item.path)} aria-current={active === item.name ? 'page' : undefined}>
              {item.name}
            </a>
          ))}
        </nav>
        <a class="nav-contact" href={linkedin} target="_blank" rel="noopener noreferrer">
          Let’s connect <Arrow diagonal />
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <section class="contact-section container" aria-labelledby="contact-heading">
      <div class="eyebrow">
        <span class="status-dot"></span> Keep the conversation going
      </div>
      <div class="contact-row">
        <h2 id="contact-heading">
          Good things start
          <br />
          with a <em>hello.</em>
        </h2>
        <div>
          <p>
            Have a question, an idea, or a project in mind?
            <br />
            I’d be happy to connect.
          </p>
          <a class="button primary" href={linkedin} target="_blank" rel="noopener noreferrer">
            Connect on LinkedIn <Arrow diagonal />
          </a>
        </div>
      </div>
    </section>
    <footer class="container site-footer">
      <a class="footer-name" href={url()}>
        Joshua Ferreira<span>Always learning. Always building.</span>
      </a>
      <div class="footer-links">
        <a href={github} target="_blank" rel="noopener noreferrer">
          GitHub <Arrow diagonal />
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn <Arrow diagonal />
        </a>
        <button class="motion-toggle" aria-pressed="false">
          Motion: on
        </button>
      </div>
      <span class="copyright">© {new Date().getFullYear()} Joshua Ferreira</span>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
