---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Orbit from '../components/Orbit.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, interests, experience, url } from '../data/site';
---

<Layout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="status-dot"></span> Joshua Ferreira / Personal portfolio
      </div>
      <h1 id="hero-heading">
        Curiosity,
        <br />
        made <em>tangible.</em>
      </h1>
      <p class="hero-intro">
        I’m Joshua. I build software, explore intelligent systems, and enjoy figuring out what makes
        things work.
      </p>
      <p class="hero-sub">
        A curious mind at the intersection of code, play, and practical problem-solving.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={url('projects/')}>
          Explore my work <Arrow />
        </a>
        <a class="text-link" href={url('about/')}>
          Meet the person behind it <Arrow diagonal />
        </a>
      </div>
    </div>
    <Orbit />
    <a class="scroll-cue mono" href="#explore">
      <span>SCROLL TO EXPLORE</span>
      <span>↓</span>
    </a>
  </section>
  <div class="interest-strip" id="explore">
    <div class="container">
      {interests.map((item) => (
        <span>
          <i>✳</i>
          {item.title}
        </span>
      ))}
    </div>
  </div>
  <section class="section container" aria-labelledby="work-heading">
    <div class="section-head">
      <div>
        <div class="eyebrow">01 / Selected work</div>
        <h2 id="work-heading">
          Ideas turned into
          <br />
          <em>something real.</em>
        </h2>
      </div>
      <div>
        <p>
          Useful tools. Playful systems.
          <br />A few things I’ve been working on.
        </p>
        <a class="text-link" href={url('projects/')}>
          All projects <Arrow />
        </a>
      </div>
    </div>
    <div class="project-grid">
      {projects.slice(0, 2).map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
    <a class="project-explore" href={url('projects/')}>
      <span class="mono">ALSO IN THE WORKSHOP</span>
      <span>Neural networks & data explorations</span>
      <Arrow />
    </a>
  </section>
  <section class="about-preview">
    <div class="container about-preview-grid">
      <div>
        <div class="eyebrow">02 / A little about me</div>
        <h2>
          More than
          <br />
          one <em>way to build.</em>
        </h2>
        <a class="text-link" href={url('about/')}>
          Read my story <Arrow />
        </a>
      </div>
      <div>
        <p class="large-copy">
          I like connecting the dots between different kinds of technical work.
        </p>
        <p>
          That might mean writing a native app, exploring a game simulation, repairing a device, or
          helping someone work through a technical problem. The common thread is curiosity—and a
          willingness to get hands-on.
        </p>
        <div class="trait-inline">
          <span>Curious</span>
          <span>Hands-on</span>
          <span>Adaptable</span>
          <span>Collaborative</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section container" aria-labelledby="experience-heading">
    <div class="section-head">
      <div>
        <div class="eyebrow">03 / Along the way</div>
        <h2 id="experience-heading">
          Learning through
          <br />
          <em>doing.</em>
        </h2>
      </div>
      <a class="text-link" href={url('experience/')}>
        Full experience <Arrow />
      </a>
    </div>
    <div class="experience-preview">
      {[experience[0], experience[2], experience[5]].map((item, index) => (
        <a class="experience-line" href={url('experience/')}>
          <span class="mono experience-index">0{index + 1}</span>
          <div>
            <h3>{item.company}</h3>
            <span>{item.role}</span>
          </div>
          <span class="experience-line-category mono">{item.category}</span>
          <span class="experience-period">{item.period}</span>
          <Arrow diagonal />
        </a>
      ))}
    </div>
  </section>
</Layout>
