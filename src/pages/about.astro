---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { interests, traits, url } from '../data/site';
---

<Layout
  title="My story — Joshua Ferreira"
  active="My story"
  description="Meet Joshua Ferreira: technically curious, hands-on, adaptable, and collaborative across software, games, AI exploration, and IT."
>
  <section class="page-intro container">
    <div class="eyebrow">The person behind the projects</div>
    <h1>
      A curious mind.
      <br />A <em>hands-on approach.</em>
    </h1>
    <p class="page-lead">
      I’m Joshua Ferreira. I enjoy taking things apart, connecting ideas, and building something
      useful from what I learn.
    </p>
  </section>
  <section class="story-section container">
    <div class="story-aside">
      <div class="personal-monogram" aria-hidden="true">
        jf<span>ALWAYS A WORK IN PROGRESS.</span>
      </div>
      <p class="mono">CODE / PLAY / PEOPLE</p>
    </div>
    <div class="story-copy">
      <div class="eyebrow">My story, so far</div>
      <h2>
        Following the question:
        <br />
        <em>“How does this work?”</em>
      </h2>
      <p>
        My path through technology has taken me from Chromebook repairs and circuit-board
        manufacturing to software development, campus IT support, and clean energy prototyping.
      </p>
      <p>
        Those experiences give me different perspectives on the same thing: a technical solution
        works best when you understand both the system and the people using it.
      </p>
      <p>
        In my projects, I follow that curiosity into native software, neural network fundamentals,
        game development, and data analysis. I’m interested in how the pieces fit together—and in
        making the result understandable.
      </p>
      <p>I’m still learning, still experimenting, and always finding another reason to build.</p>
      <a class="text-link" href={url('experience/')}>
        See where I’ve worked <Arrow />
      </a>
    </div>
  </section>
  <section class="section container">
    <div class="section-head">
      <div>
        <div class="eyebrow">How I approach things</div>
        <h2>
          A few <em>constants.</em>
        </h2>
      </div>
      <p>
        Different environments.
        <br />
        The same habits.
      </p>
    </div>
    <div class="trait-grid">
      {traits.map((trait, index) => (
        <article class="trait-card">
          <span class="mono">
            0{index + 1} / {trait.tag}
          </span>
          <h3>{trait.title}</h3>
          <p>{trait.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section interests-section container">
    <div class="section-head">
      <div>
        <div class="eyebrow">Where my curiosity goes</div>
        <h2>
          Connected by <em>curiosity.</em>
        </h2>
      </div>
    </div>
    <div class="interest-list">
      {interests.map((item) => (
        <article>
          <span class="mono">{item.number}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="interest-tools mono">{item.tools}</span>
          </div>
          <span class="interest-symbol" aria-hidden="true">
            ✳
          </span>
        </article>
      ))}
    </div>
  </section>
</Layout>
