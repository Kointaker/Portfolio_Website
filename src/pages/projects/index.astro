---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
---

<Layout
  title="Projects — Joshua Ferreira"
  active="Projects"
  description="Explore Joshua Ferreira’s native software, game simulations, neural network learning, and data analysis projects."
>
  <section class="page-intro container">
    <div class="eyebrow">Projects / Experiments & explorations</div>
    <h1>
      Built to learn.
      <br />
      Made to <em>explore.</em>
    </h1>
    <p class="page-lead">
      A collection of useful tools, playful systems, and smaller experiments. Each one starts with a
      question.
    </p>
  </section>
  <section class="projects-section container" aria-label="Project collection">
    <div class="project-filter-bar">
      <div class="project-filters" role="group" aria-label="Filter projects">
        {['All', 'Software', 'Games', 'AI / ML', 'Data'].map((filter) => (
          <button data-filter={filter} aria-pressed={filter === 'All'}>
            {filter}
          </button>
        ))}
      </div>
      <span class="mono" data-filter-count aria-live="polite">
        4 projects
      </span>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
    <p class="collection-note">
      A mix of ongoing personal projects and learning exercises. Each project page explains its
      scope and current state.
    </p>
  </section>
</Layout>
