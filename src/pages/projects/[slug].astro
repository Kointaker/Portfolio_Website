---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { projects, linkedin, url } from '../../data/site';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const next = projects[(projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length];
---

<Layout
  title={`${project.title} — Joshua Ferreira`}
  active="Projects"
  description={project.description}
>
  <section class="project-detail-intro container">
    <a class="back-link mono" href={url('projects/')}>
      ← ALL PROJECTS
    </a>
    <div class="eyebrow">{project.type}</div>
    <h1>{project.title}</h1>
    <p class="project-subtitle">{project.subtitle}</p>
    <div class="detail-meta">
      <ul class="tags" aria-label="Technologies">
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      <span class="detail-status mono">
        <span class="status-dot"></span>
        {project.status}
      </span>
    </div>
  </section>
  <div class="container detail-art">
    <ProjectArt type={project.art} large />
  </div>
  <section class="project-detail-content container">
    <aside>
      <div class="eyebrow">Project overview</div>
      <p>{project.description}</p>
      <a
        class="button secondary"
        href={project.repo || linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        {project.repo ? 'View repository' : 'Ask me about it'}
        <Arrow diagonal />
      </a>
    </aside>
    <div class="detail-story">
      <div>
        <span class="eyebrow">01 / The starting point</span>
        <h2>Why build it?</h2>
        <p>{project.purpose}</p>
      </div>
      <div>
        <span class="eyebrow">02 / The work</span>
        <h2>What I built</h2>
        <p>{project.contribution}</p>
      </div>
      <div>
        <span class="eyebrow">03 / Under the surface</span>
        <h2>Decisions that matter</h2>
        <div class="decision-list">
          {project.decisions.map((decision, index) => (
            <article>
              <span class="mono">0{index + 1}</span>
              <div>
                <h3>{decision.title}</h3>
                <p>{decision.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="scope-note">
        <span class="eyebrow">Scope & current state</span>
        <p>{project.boundary}</p>
      </div>
    </div>
  </section>
  <a class="next-project container" href={url(`projects/${next.slug}/`)}>
    <div>
      <span class="eyebrow">Keep exploring</span>
      <h2>{next.title}</h2>
    </div>
    <Arrow diagonal />
  </a>
</Layout>
