---
import Layout from '../layouts/Layout.astro';
import { experience } from '../data/site';
---

<Layout
  title="Experience — Joshua Ferreira"
  active="Experience"
  description="Joshua Ferreira’s work experience across IT support, software development, clean energy prototyping, cybersecurity research, manufacturing, and customer service."
>
  <section class="page-intro container">
    <div class="eyebrow">Experience / Work & internships</div>
    <h1>
      Different settings.
      <br />
      The same <em>curiosity.</em>
    </h1>
    <p class="page-lead">
      From the help desk to the development team, every role has added a new way to understand
      problems—and people.
    </p>
  </section>
  <section class="timeline container" aria-label="Work experience timeline">
    <aside class="timeline-aside">
      <span class="mono">THE JOURNEY SO FAR</span>
      <p>
        Software, hardware,
        <br />
        and the human side
        <br />
        of technology.
      </p>
      <span class="timeline-note">Current roles reflect my latest experience update.</span>
    </aside>
    <div class="timeline-items">
      {experience.map((item) => (
        <article class="timeline-item">
          <span class:list={['timeline-node', { current: item.current }]}></span>
          <div class="timeline-meta mono">
            <span>{item.period}</span>
            <span>{item.category}</span>
          </div>
          <h2>{item.company}</h2>
          <h3>{item.role}</h3>
          <p>{item.description}</p>
          <ul class="experience-points">
            {item.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          <ul class="tags" aria-label="Skills used">
            {item.tools.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Layout>
